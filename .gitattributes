tools/bmad-plus-npx.js text eol=lf
tools/cli/bmad-plus-cli.js text eol=lf

# Registry-generated artifacts: keep LF so a Windows checkout doesn't diverge
# from what the generators emit (their --check compares content).
registry.yaml text eol=lf
tools/build/** text eol=lf

# Eval seals bind agent sources, specs, fixtures and checkers BYTE FOR BYTE.
# A CRLF checkout on Windows and an LF checkout on Linux must hash identically,
# or every replay sealed on one platform is reported stale on the other — which
# is exactly what the 0.16.0 publication dry run caught.
src/bmad-plus/** text eol=lf
evals/** text eol=lf
evals/**/*.pyc -text

# The shipped SEO toolkit and its tested original are compared byte for byte
# (tools/build/pack-delivery.js), so both trees need the same line endings.
oveanet-pack/** text eol=lf
oveanet-pack/**/*.pyc -text
tests/unit/generate.test.js text eol=lf
tests/unit/generate-adapters.test.js text eol=lf

# ADOPTED root adapters + spine (generated by tools/build/generate-adapters.js
# --adopt from registry.yaml + tools/build/adapters.config.js — never hand-edit).
AGENTS.md text eol=lf
CLAUDE.md text eol=lf
GEMINI.md text eol=lf
CONVENTIONS.md text eol=lf
.cursor/rules/bmad-plus.mdc text eol=lf
.codex/AGENTS.md text eol=lf
.opencode/AGENTS.md text eol=lf

# Evaluation receipts identify exact bytes, including original line endings.
docs/research/agent-evaluation-2026-09-09/receipts/** -text

# Evaluation preparation and scored replay seal exact source/fixture bytes.
evals/** text eol=lf
src/bmad-plus/** text eol=lf

# Husky runs hook scripts with sh: a CRLF checkout breaks them.
.husky/* text eol=lf
